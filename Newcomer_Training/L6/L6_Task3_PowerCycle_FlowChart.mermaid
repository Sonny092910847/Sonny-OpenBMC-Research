flowchart TD
    subgraph Trigger["PowerCycle Trigger Sources"]
        A[D-Bus Request<br/>Chassis.Transition.PowerCycle] --> B[sendPowerControlEvent<br/>Event::powerCycleRequest]
        A2[IPMI Chassis Control<br/>Command 0x02] --> B
        A3[Redfish Reset Action<br/>PowerCycle] --> B
    end

    subgraph StateOn["powerStateOn() - Current State: ON"]
        B --> C[Receive Event::<br/>powerCycleRequest]
        C --> D[addRestartCause<br/>RestartCause::command]
        D --> E[gracefulPowerOffTimerStart<br/>Timer: gracefulPowerOffTimeout]
        E --> F[gracefulPowerOff<br/>Request OS Shutdown]
        F --> G[setPowerState<br/>PowerState::gracefulTransitionToOff]
    end

    subgraph GracefulOff["powerStateGracefulTransitionToOff()"]
        G --> H{Wait for Events}
        
        H -->|Event::powerOKDeAssert<br/>Power OK Lost| I[gracefulPowerOffTimer.cancel]
        I --> J[setPowerState<br/>PowerState::cycleOff]
        
        H -->|Timer Expired<br/>gracefulPowerOffTimeout| K[Log: Graceful power-off<br/>timeout exceeded]
        K --> L[forcePowerOff<br/>Force Power Off]
        L --> M[setPowerState<br/>PowerState::transitionToOff]
        
        H -->|Event::powerCycleRequest<br/>Another Cycle Request| N[gracefulPowerOffTimer.cancel]
        N --> O[forcePowerOff]
        O --> M
    end

    subgraph CycleOff["powerStateCycleOff()"]
        J --> P{Wait for Events}
        
        P -->|powerCycleTimer Expired| Q[setPowerState<br/>PowerState::waitForPSPowerOK]
        Q --> R[powerOn<br/>Assert Power Button]
        
        P -->|Event::powerOnRequest| S[powerCycleTimer.cancel]
        S --> Q
    end

    subgraph WaitPowerOK["powerStateWaitForPSPowerOK()"]
        R --> T{Wait for Events}
        
        T -->|Event::psPowerOKAssert<br/>Power OK Detected| U[psPowerOKWatchdogTimer.cancel]
        U --> V[setPowerState<br/>PowerState::waitForSIOPowerGood]
        
        T -->|Timer Expired<br/>psPowerOKWatchdogTimeout| W[setPowerState<br/>PowerState::off]
        W --> X[Log: Power supply<br/>power OK timeout]
    end

    subgraph WaitSIO["powerStateWaitForSIOPowerGood()"]
        V --> Y{Wait for Events}
        
        Y -->|Event::sioPowerGoodAssert| Z[sioPowerGoodWatchdogTimer.cancel]
        Z --> Z1[setPowerState<br/>PowerState::on]
        Z1 --> Z2[PowerCycle Complete<br/>System Running]
        
        Y -->|Timer Expired| Z3[setPowerState<br/>PowerState::off]
        Z3 --> Z4[Log: SIO power good<br/>timeout]
    end

    style A fill:#e1f5fe,stroke:#0288d1,color:#000000
    style A2 fill:#e1f5fe,stroke:#0288d1,color:#000000
    style A3 fill:#e1f5fe,stroke:#0288d1,color:#000000
    style B fill:#fff9c4,stroke:#f9a825,color:#000000
    style C fill:#fff9c4,stroke:#f9a825,color:#000000
    style D fill:#b3e5fc,stroke:#0277bd,color:#000000
    style E fill:#b3e5fc,stroke:#0277bd,color:#000000
    style F fill:#b3e5fc,stroke:#0277bd,color:#000000
    style G fill:#b3e5fc,stroke:#0277bd,color:#000000
    style I fill:#c8e6c9,stroke:#388e3c,color:#000000
    style J fill:#c8e6c9,stroke:#388e3c,color:#000000
    style K fill:#ffcdd2,stroke:#d32f2f,color:#000000
    style L fill:#ffcdd2,stroke:#d32f2f,color:#000000
    style M fill:#b3e5fc,stroke:#0277bd,color:#000000
    style N fill:#ffcdd2,stroke:#d32f2f,color:#000000
    style O fill:#ffcdd2,stroke:#d32f2f,color:#000000
    style Q fill:#b3e5fc,stroke:#0277bd,color:#000000
    style R fill:#b3e5fc,stroke:#0277bd,color:#000000
