flowchart TD
    subgraph GPIO_Event["GPIO/D-Bus Event Detection"]
        A[POST_COMPLETE Signal<br/>State Changed] --> B{state == polarity?}
        B -->|Yes| C[asserted = true<br/>POST Complete]
        B -->|No| D[asserted = false<br/>POST Not Complete / Reset]
    end

    subgraph Handler_Assert["postCompleteHandler() - Asserted Path"]
        C --> E[sendPowerControlEvent<br/>Event::postCompleteAssert]
        E --> F[setOperatingSystemState<br/>OperatingSystemStateStage::Standby]
        F --> G[Update D-Bus Property<br/>OperatingSystemState = Standby]
    end

    subgraph Handler_DeAssert["postCompleteHandler() - De-Asserted Path"]
        D --> H[sendPowerControlEvent<br/>Event::postCompleteDeAssert]
        H --> I[setOperatingSystemState<br/>OperatingSystemStateStage::Inactive]
        I --> J[Update D-Bus Property<br/>OperatingSystemState = Inactive]
    end

    subgraph StateOn["powerStateOn() - Handle postCompleteDeAssert"]
        J --> K{Current State<br/>== PowerState::on?}
        K -->|Yes| L[setPowerState<br/>PowerState::checkForWarmReset]
        L --> M[addRestartCause<br/>RestartCause::softReset]
        M --> N[warmResetCheckTimerStart<br/>Timer: 500ms]
        K -->|No| O[No Action]
    end

    subgraph Result["Final State"]
        G --> P[BIOS POST Complete<br/>OS Ready to Boot]
        N --> Q[Check if Warm Reset<br/>or Power Off]
    end

    style A fill:#e1f5fe,stroke:#0288d1,color:#000000
    style C fill:#c8e6c9,stroke:#388e3c,color:#000000
    style D fill:#fff9c4,stroke:#f9a825,color:#000000
    style E fill:#c8e6c9,stroke:#388e3c,color:#000000
    style F fill:#c8e6c9,stroke:#388e3c,color:#000000
    style G fill:#c8e6c9,stroke:#388e3c,color:#000000
    style H fill:#fff9c4,stroke:#f9a825,color:#000000
    style I fill:#fff9c4,stroke:#f9a825,color:#000000
    style J fill:#fff9c4,stroke:#f9a825,color:#000000
    style L fill:#b3e5fc,stroke:#0277bd,color:#000000
    style M fill:#b3e5fc,stroke:#0277bd,color:#000000
    style N fill:#b3e5fc,stroke:#0277bd,color:#000000
    style P fill:#c8e6c9,stroke:#388e3c,color:#000000
    style Q fill:#fff9c4,stroke:#f9a825,color:#000000
